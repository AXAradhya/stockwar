# Example env file for local development
# Copy to .env.local and customize before running `npm run dev` or `npm run build`

# Frontend feature flags
VITE_DEV_ALLOW_FALLBACKS=0      # set to 1 to allow local mock fallbacks (dev only)
VITE_ALLOW_PUBLIC_PROXIES=0     # set to 1 to enable public CORS proxies (not recommended)

# BYOK proxy (recommended)
# Example: https://<PROJECT>.supabase.co/functions/v1 or include mounted prefix
VITE_API_PROXY_URL=
VITE_API_PROXY_PREFIX=make-server-287eb62b

# For local development you can point the frontend at the included local BYOK stub:
# Uncomment to use the local stub started by `node scripts/local_byok_proxy.js`
# VITE_API_PROXY_URL=http://localhost:8787

# Provider API keys (optional if BYOK proxy is deployed)
VITE_FINNHUB_API_KEY=
VITE_NEWSAPI_KEY=
VITE_FRED_API_KEY=
VITE_EIA_API_KEY=
VITE_OPENROUTER_KEY=
VITE_GEMINI_KEY=

# Optional: allowlist for BYOK fetch proxy (comma separated hostnames)
# API_FETCH_ALLOWED=query1.finance.yahoo.com,api.coingecko.com

# Notes:
# - Do NOT commit real API keys to source control. Use environment variables or CI secrets.
# - Prefer deploying the BYOK proxy and setting `VITE_API_PROXY_URL`.
